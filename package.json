{
  "name": "todo-api",
  "version": "1.0.0",
  "description": "Todo REST API – SIT753 DevOps Pipeline Demo",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "jest --forceExit --coverage",
    "test:unit": "jest tests/unit --forceExit",
    "test:integration": "jest tests/integration --forceExit",
    "lint": "eslint src/ tests/ --ext .js",
    "lint:fix": "eslint src/ tests/ --ext .js --fix",
    "lint:report": "eslint src/ tests/ --ext .js --format json --output-file eslint-report.json || true"
  },
  "dependencies": {
    "express": "4.18.2",
    "prom-client": "15.1.0"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "supertest": "6.3.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
